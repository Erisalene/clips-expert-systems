; Лабораторна робота № 5 - Загальне завдання
; Обчислення префіксних виразів у середовищі CLIPS

(deffunction calc-expressions ()
   ; а) (3 + 4) * (5 + 6) + 7
   (bind ?a (+ (* (+ 3 4) (+ 5 6)) 7))
   (printout t "a) (+ (* (+ 3 4) (+ 5 6)) 7) = " ?a crlf)

   ; б) (5 * (5 + 6 + 7)) - ((3 * (4/9) + 2) / 8)
   (bind ?b (- (* 5 (+ 5 6 7)) (/ (+ (* 3 (/ 4 9)) 2) 8)))
   (printout t "b) (- (* 5 (+ 5 6 7)) (/ (+ (* 3 (/ 4 9)) 2) 8)) = " ?b crlf)

   ; в) 6 - 9 * 8/3 + 4 - (8 - 2 - 3) * 6/7
   (bind ?c (- (+ (- 6 (/ (* 9 8) 3)) 4) (/ (* (- (- 8 2) 3) 6) 7)))
   (printout t "v) (- (+ (- 6 (/ (* 9 8) 3)) 4) (/ (* (- (- 8 2) 3) 6) 7)) = " ?c crlf)
)
